AWSTemplateFormatVersion: 2010-09-09
Description: 'Create a VPC with Public and Private Subnets, internet G/W & NACL'
Parameters:
  VpcCIDR:
    Description: CIDR block for vpc
    Type: String
    Default: 10.0.30.40/24
Resources:
  VPC:
    Type: 'AWS::EC2::VPC'
    Properties:
      CidrBlock: !Ref VpcCIDR
      EnableDnsSupport: 'true'
      EnableDnsHostnames: 'true'
    Metadata:
      'AWS::CloudFormation::Designer':
        id: c27ade36-6a2a-4dff-9b47-9229ae19f41a
  InternetGateway:
    Type: 'AWS::EC2::InternetGateway'
    Metadata:
      'AWS::CloudFormation::Designer':
        id: 0f281fa4-8445-41f9-9588-9f2adeda0e2a
  AttachGateway:
    Type: 'AWS::EC2::VPCGatewayAttachment'
    Properties:
      VpcId: !Ref VPC
      InternetGatewayId: !Ref InternetGateway
    Metadata:
      'AWS::CloudFormation::Designer':
        id: c3abb3ac-2f32-412b-a48a-e4bea529ee7c
  PublicSubnet1:
    Type: 'AWS::EC2::Subnet'
    Properties:
      VpcId: !Ref VPC
      CidrBlock: 10.0.30.0/27
      MapPublicIpOnLaunch: 'false'
    Metadata:
      'AWS::CloudFormation::Designer':
        id: 631867f8-171c-47a7-bd6c-d300d0734fe0
  PublicSubnet2:
    Type: 'AWS::EC2::Subnet'
    Properties:
      VpcId: !Ref VPC
      CidrBlock: 10.0.30.64/27
    Metadata:
      'AWS::CloudFormation::Designer':
        id: ce4c5f3b-603e-4c78-a45c-bf6f6e3ec052
  PrivateSubnet1:
    Type: 'AWS::EC2::Subnet'
    Properties:
      VpcId: !Ref VPC
      CidrBlock: 10.0.30.128/27
    Metadata:
      'AWS::CloudFormation::Designer':
        id: 7b8058c6-0b29-41e8-9c8a-83c17f294043
  PrivateSubnet2:
    Type: 'AWS::EC2::Subnet'
    Properties:
      VpcId: !Ref VPC
      CidrBlock: 10.0.30.192/27
    Metadata:
      'AWS::CloudFormation::Designer':
        id: 63790c10-a9ac-4250-98b7-306388ab2863
  PrivateSubnet3:
    Type: 'AWS::EC2::Subnet'
    Properties:
      VpcId: !Ref VPC
      CidrBlock: 10.0.30.224/27
    Metadata:
      'AWS::CloudFormation::Designer':
        id: 6a3fe299-709d-4d2a-8f47-48ed0a036057
  InternetRouteTable:
    Type: 'AWS::EC2::RouteTable'
    Properties:
      VpcId: !Ref VPC
    Metadata:
      'AWS::CloudFormation::Designer':
        id: 0e90a873-7952-46fe-9fe6-ff3ab4647af3
  PublicRoute:
    Type: 'AWS::EC2::Route'
    DependsOn: AttachGateway
    Properties:
      RouteTableId: !Ref InternetRouteTable
      DestinationCidrBlock: 0.0.0.0/0
      GatewayId: !Ref InternetGateway
    Metadata:
      'AWS::CloudFormation::Designer':
        id: e3fe0772-5dd3-45b4-8b5e-1a0da14a70b1
  AssociatePublicRouteTable:
    Type: 'AWS::EC2::SubnetRouteTableAssociation'
    Properties:
      SubnetId: !Ref PublicSubnet2
      RouteTableId: !Ref InternetRouteTable
  Nacl:
    Type: 'AWS::EC2::NetworkAcl'
    Properties:
      VpcId: !Ref VPC
    Metadata:
      'AWS::CloudFormation::Designer':
        id: 303c7995-712d-4b69-b64d-afda447a2416
  NaclInboundRuleSSH:
    Type: 'AWS::EC2::NetworkAclEntry'
    Properties:
      NetworkAclId: !Ref Nacl
      RuleNumber: 100
      Protocol: 6
      RuleAction: allow
      Egress: 'false'
      CidrBlock: 0.0.0.0/0
      PortRange:
        From: 22
        To: 22
    Metadata:
      'AWS::CloudFormation::Designer':
        id: a1c4b47a-e9a3-47ef-8096-1d2c7a803c25
  KeyPair:
    Type: 'AWS::EC2::KeyPair'
    Properties:
      KeyName: ec2
    Metadata:
      'AWS::CloudFormation::Designer':
        id: 0b7c7fd2-c9c7-4c9c-b4e3-df3bb81194db
  EC2NetworkInterface:
    Type: 'AWS::EC2::NetworkInterface'
    Properties:
      Description: NI for ec2instance
      SubnetId: !Ref PublicSubnet2
      GroupSet:
        - !Ref APPSecurityGroup
    Metadata:
      'AWS::CloudFormation::Designer':
        id: 6298b2ee-7024-4821-8f4d-8b107653713e
  MyInstanceProfile:
    Type: 'AWS::IAM::InstanceProfile'
    Properties:
      InstanceProfileName: EC2SSMRole
      Roles:
        - !Ref MyIAMRole
    Metadata:
      'AWS::CloudFormation::Designer':
        id: 399da514-5715-4a85-88a7-0ee0293c9107
  MyIAMRole:
    Type: 'AWS::IAM::Role'
    Properties:
      RoleName: EC2SSMRole
      AssumeRolePolicyDocument:
        Version: 2012-10-17
        Statement:
          - Effect: Allow
            Principal:
              Service:
                - ec2.amazonaws.com
                - autoscaling.amazonaws.com
                - ec2scheduled.amazonaws.com
                - elasticloadbalancing.amazonaws.com
                - spot.amazonaws.com
                - spotfleet.amazonaws.com
                - transitgateway.amazonaws.com
            Action: 'sts:AssumeRole'
      Policies:
        - PolicyName: EC2SSMpolicy
          PolicyDocument:
            Version: 2012-10-17
            Statement:
              - Effect: Allow
                Action:
                  - 'ssm:StartSession'
                  - 'ssm:UpdateInformation'
                  - 'ssm:ListCommands'
                  - 'ssm:ListCommandInvocations'
                  - 'ssm:CreateDocument'
                  - 'ssm:DescribeAssociation'
                  - 'ssm:GetDeployablePatchSnapshotForInstance'
                  - 'ssm:GetDocument'
                  - 'ssm:DescribeDocument'
                  - 'ssm:GetManifest'
                  - 'ssm:GetParameters'
                  - 'ssm:ListAssociations'
                  - 'ssm:ListInstanceAssociations'
                  - 'ssm:PutInventory'
                  - 'ssm:PutComplianceItems'
                  - 'ssm:PutConfigurePackageResult'
                  - 'ssm:UpdateAssociationStatus'
                  - 'ssm:UpdateInstanceAssociationStatus'
                  - 'ssm:UpdateInstanceInformation'
                  - 'ssm:DescribeAssociation'
                  - 'ssm:GetDeployablePatchSnapshotForInstance'
                  - 'ssm:GetDocument'
                  - 'ssm:DescribeDocument'
                  - 'ssm:GetManifest'
                  - 'ssm:GetParameter'
                  - 'ssm:GetParameters'
                  - 'ssm:ListAssociations'
                  - 'ssm:ListInstanceAssociations'
                  - 'ssm:PutInventory'
                  - 'ssm:PutComplianceItems'
                  - 'ssm:PutConfigurePackageResult'
                  - 'ssm:UpdateAssociationStatus'
                  - 'ssm:UpdateInstanceAssociationStatus'
                  - 'ssm:UpdateInstanceInformation'
                  - 'cloudformation:*'
                  - 'elasticloadbalancing:*'
                  - 'ec2:*'
                  - 'cloudwatch:*'
                  - 'autoscaling:*'
                Resource: '*'
    Metadata:
      'AWS::CloudFormation::Designer':
        id: 86616e78-f0ae-4c80-9079-010d88ce37cf
  MyElasticIP:
    Type: 'AWS::EC2::EIP'
    Metadata:
      'AWS::CloudFormation::Designer':
        id: 2bf8b0f6-64b5-4a27-a3c8-f0fb97cf084f
  MyS3Bucket:
    Type: 'AWS::S3::Bucket'
    Properties:
      BucketName: ec2-creates
    Metadata:
      'AWS::CloudFormation::Designer':
        id: 3557aba7-c901-4d5a-a6e9-ebda3966b7fd
  APPSecurityGroup:
    Type: 'AWS::EC2::SecurityGroup'
    Properties:
      GroupDescription: SG for server
      VpcId: !Ref VPC
      SecurityGroupIngress:
        - IpProtocol: tcp
          FromPort: 22
          ToPort: 22
          CidrIp: 0.0.0.0/0
        - IpProtocol: tcp
          FromPort: 8080
          ToPort: 8080
          CidrIp: 0.0.0.0/0
        - IpProtocol: tcp
          FromPort: 80
          ToPort: 80
          CidrIp: 0.0.0.0/0
    Metadata:
      'AWS::CloudFormation::Designer':
        id: aa2c60b1-ee4a-42e6-8aa2-f288ef3a2277
  EC2Instance:
    Type: 'AWS::EC2::Instance'
    Properties:
      InstanceType: t2.micro
      KeyName: ec2
      ImageId: ami-0287a05f0ef0e9d9a
      IamInstanceProfile: EC2SSMRole
      NetworkInterfaces:
        - AssociatePublicIpAddress: 'true'
          DeviceIndex: '0'
          SubnetId: !Ref PublicSubnet2
          GroupSet:
            - !Ref DBSecurityGroup
      UserData:
        'Fn::Base64': !Sub >
          #!/bin/bash -xe

          exec > >(tee /var/log/user-data.log|logger -t user-data -s
          2>/dev/console) 2>&1

          echo "Starting UserData script..."

          # Rest of your script

          sudo apt-get update

          sudo apt-get upgrade

          sudo apt install php libapache2-mod-php -y

          sudo apt install php-cli -y

          sudo apt install php-cgi -y

          sudo apt install php-mysql -y

          sudo systemctl restart apache2.service

          touch phpinfo.php

          vi phpinfo.php
    Metadata:
      'AWS::CloudFormation::Designer':
        id: ee3739f2-cd8e-4e93-92e0-34d73346755f
  DBNetworkInterface:
    Type: 'AWS::EC2::NetworkInterface'
    Properties:
      Description: NI for ec2instance
      SubnetId: !Ref PublicSubnet2
      GroupSet:
        - !Ref DBSecurityGroup
    Metadata:
      'AWS::CloudFormation::Designer':
        id: 8bb1cbbe-c506-4428-a780-c0772ab59b6c
  DBSecurityGroup:
    Type: 'AWS::EC2::SecurityGroup'
    Properties:
      GroupDescription: SG for server
      VpcId: !Ref VPC
      SecurityGroupIngress:
        - IpProtocol: tcp
          FromPort: 22
          ToPort: 22
          CidrIp: 0.0.0.0/0
        - IpProtocol: tcp
          FromPort: 8080
          ToPort: 8080
          CidrIp: 0.0.0.0/0
        - IpProtocol: tcp
          FromPort: 80
          ToPort: 80
          CidrIp: 0.0.0.0/0
        - IpProtocol: tcp
          FromPort: 27017
          ToPort: 27017
          CidrIp: 0.0.0.0/0
    Metadata:
      'AWS::CloudFormation::Designer':
        id: 3afb64e7-0103-4ac6-a5c3-f3f127d9f813
  DBServer:
    Type: 'AWS::EC2::Instance'
    Properties:
      InstanceType: t2.micro
      KeyName: ec2
      ImageId: ami-0287a05f0ef0e9d9a
      IamInstanceProfile: EC2SSMRole
      NetworkInterfaces:
        - AssociatePublicIpAddress: 'true'
          DeviceIndex: '0'
          SubnetId: !Ref PublicSubnet2
          GroupSet:
            - !Ref DBSecurityGroup
      UserData:
        'Fn::Base64': !Sub >
          #!/bin/bash -xe

          sudo apt update

          sudo apt upgrade

          curl -fsSL https://www.mongodb.org/static/pgp/server-4.4.asc | sudo
          apt-key add -

          apt-key list

          echo "deb [ arch=amd64,arm64 ] https://repo.mongodb.org/apt/ubuntu
          focal/mongodb-org/4.4 multiverse" | sudo tee
          /etc/apt/sources.list.d/mongodb-org-4.4.list

          sudo apt update
    Metadata:
      'AWS::CloudFormation::Designer':
        id: 59f69379-6742-41c4-9803-73b77e821d1a
Outputs:
  VpcId:
    Description: VPC ID
    Value: !Ref VPC
  PublicSubnet1Id:
    Description: Public Subnet 1 ID
    Value: !Ref PublicSubnet1
  PublicSubnet2Id:
    Description: Public Subnet 2 ID
    Value: !Ref PublicSubnet2
  PrivateSubnet1Id:
    Description: Private Subnet 1 ID
    Value: !Ref PrivateSubnet1
  PrivateSubnet2Id:
    Description: Private Subnet 2 ID
    Value: !Ref PrivateSubnet2
  PrivateSubnet3Id:
    Description: Private Subnet 3 ID
    Value: !Ref PrivateSubnet3
  InternetGatewayId:
    Description: Internet Gateway Id
    Value: !Ref InternetGateway
  InstanceId:
    Description: EC2 Instance ID
    Value: !Ref EC2Instance
  MongoDBConnection:
    Description: Connection details for MongoDB
    Value: !Sub 'mongodb://${DBServer.PrivateDnsName}:27017/'
  TomcatURL:
    Description: URL of the Apache Tomcat Server
    Value: !Sub 'http://${EC2Instance.PublicDnsName}:8080'
  ElasticIPAddress:
    Description: the allocated elastic ip address
    Value: !GetAtt MyElasticIP.PublicIp
  S3BucketName:
    Description: ec2-creates
    Value: !Ref MyS3Bucket
